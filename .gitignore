toan/data/
**/data/*.json
**/data/uploads/
**/data/backup/

# File xuất từ web (có thể chứa PIN / bài làm / điểm)
# - sao lưu toàn bộ (Dashboard → Dữ liệu)
toan7-saoluu-*.json
# - bài chờ chấm gửi cho AI / kết quả AI chấm
cham-bai-*.json
ket-qua-cham*.json
# - bài làm con gửi phụ huynh / gói giao bài (có PIN của con)
bai-lam-*.json
giao-bai-*.json

